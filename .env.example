# Copy to .env and fill in. For Gmail, create an App Password (Google Account > Security > App passwords).
# On Streamlit Community Cloud, put the same keys in the app's Secrets instead (never in the repo).
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Inbox that receives every demo email, and every SE's default address. Defaults to SMTP_USER.
MAIL_TO=you@gmail.com
# Allow "Production" delivery straight to each SE's address. Leave unset on a public deployment.
ALLOW_SE_DELIVERY=false
